{% include ocean-sprites.liquid %}
<div class="ocean" aria-hidden="true">
  <svg class="jelly"><use href="#sea-jellyfish" /></svg>
  <svg class="whale"><use href="#sea-whale" /></svg>
  <svg class="dolphin"><use href="#sea-dolphin" /></svg>
  <svg class="star"><use href="#sea-starfish" /></svg>
  <svg class="horse"><use href="#sea-seahorse" /></svg>
  <svg class="octo"><use href="#sea-octopus" /></svg>
  <svg class="turtle"><use href="#sea-turtle" /></svg>
  <svg class="crab"><use href="#sea-crab" /></svg>
  <svg class="shell"><use href="#sea-shell" /></svg>
  <svg class="weed1"><use href="#sea-weed" /></svg>
  <svg class="weed2"><use href="#sea-weed" /></svg>
  <svg class="bub1"><use href="#sea-bubbles" /></svg>
  <svg class="bub2"><use href="#sea-bubbles" /></svg>
</div>
<script>
  // Starfish cursor winks while the mouse button is held, then smiles again.
  (function () {
    var root = document.documentElement;
    var timer;
    document.addEventListener("mousedown", function () {
      clearTimeout(timer);
      root.classList.add("starfish-wink");
    });
    document.addEventListener("mouseup", function () {
      timer = setTimeout(function () {
        root.classList.remove("starfish-wink");
      }, 350);
    });
  })();
</script>
